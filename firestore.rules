rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Funções auxiliares ----------
    function isSignedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function userData() {
      return userDoc().data;
    }

    function isActiveUser() {
      return isSignedIn() && userDoc().data.active != false;
    }

    function isAdmin() {
      return isSignedIn() && userData().role == 'admin';
    }

    // Só permite alterar os campos informados (o resto deve permanecer igual)
    function onlyChangedFields(allowed) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(allowed);
    }

    // ---------- users ----------
    // Cada usuário pode ler o próprio perfil; admin lê/gerencia todos.
    match /users/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      allow create, update: if isAdmin();
      allow delete: if false; // usuários nunca são apagados, apenas desativados
    }

    // ---------- equipments ----------
    match /equipments/{equipmentId} {
      allow read: if isActiveUser();
      allow create: if isAdmin();
      // Admin pode alterar qualquer campo.
      // Operador só pode alterar quantidade/status como efeito de uma
      // movimentação (o restante do cadastro é responsabilidade do admin).
      allow update: if isAdmin() ||
        (isActiveUser() && onlyChangedFields(['quantity', 'status', 'updatedAt', 'updatedBy', 'updatedByName']));
      allow delete: if false; // nunca apagar equipamentos, usar status "baixado"
    }

    // ---------- responsibles ----------
    match /responsibles/{responsibleId} {
      allow read: if isActiveUser();
      allow create, update: if isAdmin();
      allow delete: if false;
    }

    // ---------- movements ----------
    // Regra mais importante do sistema: uma movimentação confirmada é
    // imutável. Correções são novos documentos, nunca updates.
    match /movements/{movementId} {
      allow read: if isActiveUser();
      allow create: if isActiveUser();
      allow update, delete: if false;
    }

    // Contador usado para gerar o número sequencial das movimentações.
    match /counters/{counterId} {
      allow read: if isActiveUser();
      allow write: if isActiveUser() &&
        request.resource.data.value is int &&
        (resource == null || request.resource.data.value > resource.data.value);
    }

    // ---------- maintenance ----------
    match /maintenance/{maintenanceId} {
      allow read: if isActiveUser();
      allow create: if isActiveUser();
      allow update: if isAdmin();
      allow delete: if false;
    }

    // ---------- auditLogs ----------
    // Qualquer usuário ativo pode gerar um registro de auditoria (a própria
    // ação do sistema), mas ninguém pode editar ou apagar, e só admin lê.
    match /auditLogs/{logId} {
      allow create: if isActiveUser();
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    // ---------- settings ----------
    match /settings/{settingId} {
      allow read: if isActiveUser();
      allow write: if isAdmin();
    }

    // ---------- notifications ----------
    match /notifications/{notificationId} {
      allow read: if isActiveUser();
      allow create, update: if isActiveUser();
      allow delete: if false;
    }
  }
}
