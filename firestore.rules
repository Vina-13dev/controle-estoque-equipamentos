rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isRootAdmin() {
      return signedIn() && request.auth.uid == 'RHvPSwuTEeY0alV2aWgTbRWPuBt1';
    }

    function myUserPath() {
      return /databases/$(database)/documents/stockUsers/$(request.auth.uid);
    }

    function myProfileExists() {
      return signedIn() && exists(myUserPath());
    }

    function me() {
      return get(myUserPath()).data;
    }

    function activeUser() {
      return isRootAdmin() || (
        myProfileExists() &&
        me().active == true
      );
    }

    function isAdmin() {
      return isRootAdmin() || (
        activeUser() &&
        myProfileExists() &&
        me().role == 'admin'
      );
    }

    function canAccessUnit(unitId) {
      return isAdmin() || (
        activeUser() &&
        myProfileExists() &&
        me().allowedUnitIds is list &&
        me().allowedUnitIds.hasAny([unitId])
      );
    }

    // Usuários
    match /stockUsers/{userId} {
      allow get: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();

      // Usuário novo pode criar somente o próprio perfil pendente.
      allow create: if (
        signedIn() &&
        request.auth.uid == userId &&
        request.resource.data.role == 'operator' &&
        request.resource.data.active == false &&
        request.resource.data.allowedUnitIds is list &&
        request.resource.data.allowedUnitIds.size() == 0
      ) || isAdmin();

      allow update: if isAdmin();
      allow delete: if false;
    }

    // Unidades
    match /stockUnits/{unitId} {
      allow read: if isAdmin() || canAccessUnit(unitId);
      allow create, update: if isAdmin();
      allow delete: if false;
    }

    // Itens
    match /stockItems/{itemId} {
      allow read: if canAccessUnit(resource.data.unitId);
      allow create: if canAccessUnit(request.resource.data.unitId);
      allow update: if canAccessUnit(resource.data.unitId);
      allow delete: if false;
    }

    // Movimentações / histórico
    match /stockMovements/{movementId} {
      allow read: if canAccessUnit(resource.data.unitId);
      allow create: if canAccessUnit(request.resource.data.unitId)
                    && request.resource.data.createdBy == request.auth.uid;
      allow update, delete: if false;
    }

    // Bloqueia qualquer coleção não prevista.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
